# La imagen solo copia pyproject.toml, uv.lock, README.md, src/ y corpus/
# (ver Dockerfile). Esta lista reduce el contexto de build y evita que material
# local (secretos, notas, datos docentes) llegue al daemon de Docker.
.git
.gitignore
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
.chroma
*.db
*.db.bak
*.sqlite
.env
.env.*
!.env.example
reports
data
vault
.claude
docs
tests
node_modules
.DS_Store
graphify-out
*.png
HANDOFF.md
PLAN_V4.md
ROSETTA_FLUJO_COMPLETO.md
START_HERE.md
NEXT_STEPS.md
CLAUDE.md
PLAYBOOK_*.md
corpus/**/*.pdf
corpus/*.pdf
corpus/*.PDF
