# ===========================================================================
# ROSETTA — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees .env al repositorio.
# ===========================================================================

# --- LLM: Claude API (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- RAG: ChromaDB ---
# Persistencia local; cambiar a URL remota cuando se despliegue
CHROMADB_PATH=./.chroma
CHROMADB_COLLECTION=rosetta_normativa

# --- Grafo: Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_local_only

# --- API: FastAPI ---
ROSETTA_API_HOST=127.0.0.1
ROSETTA_API_PORT=8000
ROSETTA_API_RELOAD=true

# --- Sensores Red Team (opcionales, se activan si se definen) ---
# Shodan: https://account.shodan.io/
SHODAN_API_KEY=

# Have I Been Pwned: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# --- Sensores Blue Team (opcionales) ---
# Wazuh API
WAZUH_API_URL=https://wazuh.local:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
