# ===========================================================================
# ROSETTA - Variables de entorno
# Copia este archivo como .env:   cp .env.example .env
# Todos los valores de este fichero son FICTICIOS. NUNCA commitees .env.
# ===========================================================================

# --- LLM: proveedor activo ---------------------------------------------------
# Opciones: ollama | claude | openai
#   ollama -> modelo local, sin API key ni coste (recomendado para probar)
#   claude -> Anthropic (producción); requiere ANTHROPIC_API_KEY real
LLM_PROVIDER=ollama

# Ollama (modelos locales). qwen2.5:14b necesita ~9 GB de disco y ~10-12 GB de
# RAM/VRAM libres (ver README). Descarga previa: ollama pull qwen2.5:14b
#   - ROSETTA en Docker y Ollama en el equipo anfitrión: host.docker.internal
#   - ROSETTA fuera de Docker (uv run uvicorn ...): http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b

# Claude / Anthropic (solo si LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-api03-EJEMPLO-no-es-una-clave-real
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI o endpoint compatible (solo si LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-EJEMPLO-no-es-una-clave-real
OPENAI_MODEL=gpt-4o
# OPENAI_API_BASE=https://api.openai.com/v1

# --- Marcos activos por defecto del Traductor (CSV) --------------------------
# Las peticiones a /translate pueden pedir otros marcos de forma explícita.
ROSETTA_MARCOS=iso_27001_2022,ens_2022

# --- RAG: ChromaDB -------------------------------------------------------------
# En Docker se fija en docker-compose.yml (/app/.chroma, volumen persistente).
CHROMADB_PATH=./.chroma
CHROMADB_COLLECTION=rosetta_normativa

# --- Grafo: Neo4j ----------------------------------------------------------------
# En Docker el host es el nombre del servicio (lo fija docker-compose.yml).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambia-esta-clave-local

# --- API: FastAPI ------------------------------------------------------------------
ROSETTA_API_HOST=127.0.0.1
ROSETTA_API_PORT=8000
ROSETTA_API_RELOAD=false

# --- Almacenes locales (fuera de Docker; en Docker los fija docker-compose.yml) ---
ROSETTA_SESSION_DB=.rosetta_sessions.db
ROSETTA_CONTROLS_DB=.rosetta_controls.db
ROSETTA_REPORTS_DIR=reports

# --- Autenticación del panel (JWT + HTTP Basic de respaldo) ---------------------
# Credenciales de PRUEBA, ficticias: cámbialas antes de exponer la aplicación.
ROSETTA_USER=auditor-demo
ROSETTA_PASSWORD=cambia-esta-clave-de-prueba
# Cuentas adicionales (opcional). Formato: usuario1:clave1,usuario2:clave2
ROSETTA_USERS_EXTRA=
# Secreto para firmar los JWT (HS256): OBLIGATORIO, aleatorio y de 32 caracteres
# o más. Se deja vacío a propósito: un valor de ejemplo sería un secreto conocido.
# Generar con:  python -c "import secrets; print(secrets.token_hex(32))"
ROSETTA_JWT_SECRET=

# --- Sensores Red Team (opcionales; no integrados en esta versión) --------------
SHODAN_API_KEY=
HIBP_API_KEY=

# --- Sensores Blue Team (opcionales) ----------------------------------------------
WAZUH_API_URL=https://wazuh.example:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=

# --- Logging -----------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
