# ===========================================================================
# ROSETTA - Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees .env al repositorio.
# ===========================================================================

# --- LLM: proveedor activo ---
# Opciones: claude | ollama | openai  (por defecto: claude)
LLM_PROVIDER=claude

# Claude / Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama (modelos locales, desarrollo sin coste / on-premise)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI (o endpoint compatible: Azure OpenAI, vLLM, LM Studio...)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
# OPENAI_API_BASE=https://api.openai.com/v1

# --- RAG: ChromaDB ---
CHROMADB_PATH=./.chroma
CHROMADB_COLLECTION=rosetta_normativa

# --- Grafo: Neo4j ---
# En docker-compose el host es el nombre del servicio: bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_local_only

# --- API: FastAPI ---
ROSETTA_API_HOST=127.0.0.1
ROSETTA_API_PORT=8000
ROSETTA_API_RELOAD=false

# --- Autenticacion del panel (JWT + HTTP Basic fallback, opcional) ---
# Si ROSETTA_USER esta vacio, la API no exige autenticacion.
ROSETTA_USER=
ROSETTA_PASSWORD=

# Credenciales adicionales (opcional). Formato: user1:pass1,user2:pass2
# Util para dar acceso a evaluadores/profesores sin compartir la cuenta principal.
ROSETTA_USERS_EXTRA=

# Secreto JWT (HS256). En PRODUCCION debe ser aleatorio y >= 32 caracteres.
# Generar con: openssl rand -hex 32
ROSETTA_JWT_SECRET=

# --- Marcos normativos activos al arrancar (CSV) ---
ROSETTA_MARCOS=iso_27001_2022

# --- Almacen de sesion (SQLite) ---
ROSETTA_SESSION_DB=.rosetta_sessions.db

# --- Sensores Red Team (opcionales) ---
SHODAN_API_KEY=
HIBP_API_KEY=

# --- Sensores Blue Team (opcionales) ---
WAZUH_API_URL=https://wazuh.local:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
